olor:rgba(181,138,42,.2)}.dungeon-guaranteed-tag{color:#9a731e;border-color:rgba(181,138,42,.45);background:rgba(255,244,204,.5)}
.dungeon-ticket{border-color:rgba(22,143,131,.36);background:rgba(22,143,131,.08);color:#168f83}.dungeon-ticket.cost{border-color:#00b98f;background:linear-gradient(135deg,rgba(0,214,165,.35),rgba(0,214,165,.14));color:#008e70;text-shadow:0 0 6px rgba(0,185,143,.2);box-shadow:0 0 16px rgba(0,185,143,.32)}
.ghost-hunt-ring{background:rgba(255,255,255,.52);border-color:rgba(22,143,131,.22)}.ghost-hunt-ring.tenth{border-color:rgba(181,138,42,.55);background:rgba(255,244,204,.42)}.ghost-hunt-ring>strong{color:#215164}.ghost-hunt-ring.tenth>strong,.ghost-hunt-double{color:#9a731e}.ghost-hunt-ring b{color:#168f83}.ghost-hunt-evidence{background:rgba(22,143,131,.06);border-color:#168f83}.ghost-hunt-double{border-color:rgba(181,138,42,.5)}

.dungeon-complete-badge{background:rgba(22,143,131,.1);border-color:rgba(22,143,131,.42);color:#168f83}.dungeon-card.complete{border-color:rgba(181,138,42,.5)}.dungeon-completion-summary>div{background:rgba(255,244,204,.35);border-color:rgba(181,138,42,.25)}.dungeon-completion-summary strong{color:#215164}.dungeon-completion-summary strong.final{color:#9a731e}
